        "import numpy as np\n",
        "data=[10,20,30,40,50]\n",
        "mean=np.mean(data)\n",
        "print(\"mean:\",mean)\n",
        "std_dev =np.std(data,ddof=1)\n",
        "print(\"standard deviation:\",std_dev)\n",
        "x=40\n",
        "z_score=(x-mean)/std_dev\n",
        "print(\"z-score of 40\",z_score)"
